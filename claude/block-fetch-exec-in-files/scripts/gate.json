{
  "kind": "content_regex",
  "on": [
    "commit",
    "tool_use"
  ],
  "action": "warn",
  "message": "A line added to a build, CI or install file wires a network download straight into a shell or interpreter (or ADDs a URL without --checksum), so whoever controls that URL controls what runs. Download to a file, verify it (sha256sum -c against a pinned checksum, gpg --verify, or ADD --checksum=sha256:...), then run it as a separate step. This policy only warns while it is measured. Waiver: 'pragma: allowlist fetch-exec' on the same line. A person's commit honours it; in the agent only a line already in HEAD counts. An agent asks a person; it never writes the pragma.",
  "paths": [
    "Dockerfile*",
    "*/Dockerfile*",
    "dockerfile*",
    "*/dockerfile*",
    "*.Dockerfile",
    "*.dockerfile",
    "Containerfile*",
    "*/Containerfile*",
    "containerfile*",
    "*/containerfile*",
    "Makefile",
    "*/Makefile",
    "makefile",
    "*/makefile",
    "GNUmakefile",
    "*/GNUmakefile",
    "*.mk",
    "justfile",
    "*/justfile",
    "Justfile",
    "*/Justfile",
    "Taskfile.yml",
    "Taskfile.yaml",
    "*/Taskfile.yml",
    "*/Taskfile.yaml",
    "Taskfile.dist.yml",
    "Taskfile.dist.yaml",
    "*/Taskfile.dist.yml",
    "*/Taskfile.dist.yaml",
    ".justfile",
    "*/.justfile",
    "*.sh",
    "*.bash",
    "*.zsh",
    "*.ksh",
    "*.bat",
    "*.cmd",
    "*.ps1",
    "*.psm1",
    ".envrc",
    "*/.envrc",
    "Vagrantfile",
    "*/Vagrantfile",
    "Procfile",
    "*/Procfile",
    ".github/workflows/*",
    "*/.github/workflows/*",
    ".github/actions/*",
    "*/.github/actions/*",
    ".travis.yml",
    ".drone.yml",
    ".buildkite/*",
    ".gitlab/*",
    ".gitlab-ci.yml",
    "*/.gitlab-ci.yml",
    "Jenkinsfile*",
    "*/Jenkinsfile*",
    ".circleci/*",
    "azure-pipelines*.yml",
    "*/azure-pipelines*.yml",
    "azure-pipelines*.yaml",
    "*/azure-pipelines*.yaml",
    ".azure-pipelines/*",
    "bitbucket-pipelines.yml",
    "*/bitbucket-pipelines.yml",
    "cloudbuild.yml",
    "cloudbuild.yaml",
    "*/cloudbuild.yml",
    "*/cloudbuild.yaml",
    "package.json",
    "*/package.json"
  ],
  "params": {
    "scan": "added_lines",
    "allowlist_pragma": "pragma:\\s*allowlist\\s+fetch-exec",
    "content_pattern": "^\\s*(?i:add)\\s+(?:--(?!checksum)[\\w-]+(?:=\\S+)?\\s+)*(?:\\[\\s*)?[\"']?https?://|^(?!\\s*(?:-\\s+)?[@+-]*(?:echo|printf|Write-Host)\\b(?:[^;&|\\n\"']|\"[^\"\\n]*\"|'[^'\\n]*')*$)(?:[^#\\n]|(?<=\\S)#)*?(?:(?:(?<![\\w.-])(?:[c]url|[w]get2?|[a]ria2c|[l]ynx|(?i:[i]wr|[i]rm|[i]nvoke-webrequest|[i]nvoke-restmethod|[d]ownloadstring))|(?i:\\.[d]ownloadstring))(?![\\w-])(?:[^;&|\\n#]|(?<!\\s)#|&(?![&>])|\\|(?!\\|))*?\\|&?\\s*[({]?\\s*(?:(?:[\\w./-]*/)?(?:sudo|doas|env|exec|command|nohup|nice|timeout|stdbuf|xargs)(?:\\s+(?:-\\S+(?:\\s+\\w+(?=\\s+\\S))?|\\w+=\\S*|[0-9][\\w.]*))*\\s+)*[\"']?(?:[\\w./-]*/)?(?:(?:ba|z|da|k|a|c|tc|mk)?sh|fish|busybox\\s+sh|(?:python[0-9.]*|perl|ruby|node|php|lua)(?=\\s*(?:$|-(?:\\s|$)|[;&|)'\"`])|(?:\\s+-[A-Za-z]+)+(?:\\s+-)?\\s*(?:$|[;&|)]))|(?:source|\\.)\\s+/dev/(?:stdin|fd/0)|(?i:iex|invoke-expression|pwsh|powershell))(?![\\w.-])|(?<![\\w.-])(?:eval|source|\\.|(?:ba|z|da|k|a|tc|mk)?sh|fish|python[0-9.]*|perl|ruby|node|php|lua)(?:\\s+-\\S+)*\\s+(?:/dev/stdin\\s+)?(?:<<<\\s*|<\\s*)?[\"']?(?:\\$\\(|<\\(|`)\\s*(?:(?:sudo|doas|command|env|exec)\\s+(?:-\\S+\\s+)*)*(?:[\\w./-]*/)?(?:[c]url|[w]get2?|[a]ria2c|[l]ynx|(?i:[i]wr|[i]rm|[i]nvoke-webrequest|[i]nvoke-restmethod|[d]ownloadstring))(?![\\w-])|(?i:(?<![\\w-])(?:iex|invoke-expression)[\\s\"'(]*(?:(?:&\\s*\\{|\\$)[\\s\"'(]*)*(?:[i]rm|[i]wr|[c]url|[i]nvoke-webrequest|[i]nvoke-restmethod|new-object\\s+(?:system\\.)?net\\.webclient)(?![\\w-])|\\[scriptblock\\]::create\\(\\s*\\(*\\s*(?:[i]rm|[i]wr)))"
  }
}
