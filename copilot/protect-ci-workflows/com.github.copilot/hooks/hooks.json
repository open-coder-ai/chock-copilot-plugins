{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash|powershell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-}\"; [ -n \"$r\" ] && [ -f \"$r/scripts/vscode_copilot.py\" ] || exit 0; exec python3 \"$r/scripts/vscode_copilot.py\" --guard \"$r/scripts/protect-ci-workflows.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
