{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/vscode_copilot.py\" --guard \"${PLUGIN_ROOT}/scripts/protect-agent-config.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
