{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-}\"; [ -n \"$r\" ] && [ -f \"$r/scripts/vscode_copilot.py\" ] || exit 0; exec git -c \"alias.chock-sh=!sh\" chock-sh \"$r/scripts/launch.sh\" \"$r/scripts/vscode_copilot.py\" --gate \"$r/scripts/gate.json\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
